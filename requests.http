###############################
# AUTENTIKASI
###############################

### 1. Register (201; ulang = 409 EMAIL_DUPLIKAT)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "aderatu@gmail.com", "password": "rahasia123" }

### Register tidak valid (422 VALIDATION_ERROR)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "bukan-email", "password": "123" }

### 2. Login (200 OK)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "aderatu@gmail.com", "password": "rahasia123" }

### Login gagal, password salah (401 LOGIN_GAGAL)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "aderatu@gmail.com", "password": "salah-banget" }

### Login gagal, email tidak terdaftar (401 LOGIN_GAGAL, pesan sama)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "tidakada@contoh.com", "password": "rahasia123" }

### /auth/saya tanpa token (401 TOKEN_DIPERLUKAN)
GET {{baseUrl}}/auth/saya

### /auth/saya dengan token (200)
GET {{baseUrl}}/auth/saya
Authorization: Bearer {{token}}

###############################
# HALAMAN PUBLIK
###############################

### 3. Daftar produk tanpa token (200)
GET {{baseUrl}}/products

### Detail produk tanpa token (200)
GET {{baseUrl}}/products/1

### Daftar pesanan tanpa token (200)
GET {{baseUrl}}/orders

###############################
# HALAMAN WAJIB LOGIN
###############################

### 4. Tambah produk TANPA token (401 TOKEN_DIPERLUKAN)
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": "Produk Auth - Ade Ratu Safitri", "sku": "AUT-002", "category": "Elektronik", "price": 50000, "stock": 5 }

### 5. Tambah produk DENGAN token (201)
# @name tambahProduk
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "Produk Auth - Ade Ratu Safitri", "sku": "AUT-002", "category": "Elektronik", "price": 50000, "stock": 5 }

### Ubah produk dengan token (200)
PUT {{baseUrl}}/products/{{tambahProduk.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "Produk Auth v2", "sku": "AUT-002", "category": "Elektronik", "price": 60000, "stock": 5 }

### Buat pesanan tanpa token (401)
POST {{baseUrl}}/orders
Content-Type: application/json

{ "productId": 1, "customerName": "Ade", "quantity": 1 }

### Buat pesanan dengan token (201)
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{ "productId": 1, "customerName": "Ade", "quantity": 1 }

### Hapus produk tanpa token (401)
DELETE {{baseUrl}}/products/{{tambahProduk.response.body.data.id}}

### Hapus produk dengan token (204)
DELETE {{baseUrl}}/products/{{tambahProduk.response.body.data.id}}
Authorization: Bearer {{token}}

###############################
# PERCOBAAN WAJIB
###############################

### Percobaan 1: token dipalsukan (401 TOKEN_TIDAK_VALID)
# ADE RATU SAFITRI - F1D02410033
GET {{baseUrl}}/auth/saya
Authorization: Bearer {{tokenPalsu}}

### Percobaan 2: token expired (401 TOKEN_TIDAK_VALID)
# ADE RATU SAFITRI - F1D02410033
GET {{baseUrl}}/auth/saya
Authorization: Bearer {{tokenExpired}}
@baseUrl = http://localhost:3000

###############################
# PRODUCTS: GET daftar
###############################

### Daftar produk, default (200)
GET {{baseUrl}}/products

### Paginasi halaman 2, ukuran 3 (200)
GET {{baseUrl}}/products?halaman=2&ukuran=3

### Filter kategori Fashion (200)
GET {{baseUrl}}/products?category=Fashion

### Filter kategori Buku + paginasi (200)
GET {{baseUrl}}/products?category=Buku&halaman=1&ukuran=1

###############################
# PRODUCTS: GET detail
###############################

### Detail produk (200)
GET {{baseUrl}}/products/1

### Produk tidak ada (404)
GET {{baseUrl}}/products/999

### ID tidak valid (400)
GET {{baseUrl}}/products/abc

###############################
# PRODUCTS: POST
###############################

### Tambah produk (201)
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Headset Gaming - Ade Ratu Safitri",
  "sku": "ELK-004",
  "category": "Elektronik",
  "price": 350000,
  "stock": 20
}

### SKU duplikat (409)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Produk Duplikat - Ade Ratu Safitri",
  "sku": "ELK-001",
  "category": "Elektronik",
  "price": 100000,
  "stock": 5
}

### Data tidak valid: name kosong dan price negatif (422)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "",
  "sku": "TST-422",
  "category": "Elektronik",
  "price": -100,
  "stock": 5
}

### Field kurang (422)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Tanpa SKU"
}

### JSON rusak (400)
POST {{baseUrl}}/products
Content-Type: application/json

{ 
  "name": "rusak",
}

###############################
# PRODUCTS: PUT
###############################

### Ubah produk yang baru dibuat (200)
PUT {{baseUrl}}/products/{{createProduct.response.body.data.id}}
Content-Type: application/json

{
  "name": "Headset Gaming Pro - Ade Ratu Safitri",
  "sku": "ELK-004",
  "category": "Elektronik",
  "price": 400000,
  "stock": 15
}

### Produk tidak ada (404)
PUT {{baseUrl}}/products/999
Content-Type: application/json

{
  "name": "Tidak Ada",
  "sku": "XXX-999",
  "category": "Elektronik",
  "price": 1000,
  "stock": 1
}

### SKU bentrok dengan produk lain (409)
PUT {{baseUrl}}/products/{{createProduct.response.body.data.id}}
Content-Type: application/json

{
  "name": "Headset Gaming Pro - Ade Ratu Safitri",
  "sku": "ELK-001",
  "category": "Elektronik",
  "price": 400000,
  "stock": 15
}

### Data tidak lengkap (422)
PUT {{baseUrl}}/products/{{createProduct.response.body.data.id}}
Content-Type: application/json

{
  "name": "Hanya nama"
}

### ID tidak valid (400)
PUT {{baseUrl}}/products/abc
Content-Type: application/json

{
  "name": "Test",
  "sku": "TST-001",
  "category": "Elektronik",
  "price": 1000,
  "stock": 1
}

###############################
# ORDERS
###############################

### Buat pesanan, berhasil (201)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": 1,
  "customerName": "Ade Ratu Safitri",
  "quantity": 2
}

### Stok tidak cukup (409)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": 1,
  "customerName": "Ade Ratu Safitri",
  "quantity": 999
}

### Produk tidak ada (404)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": 999,
  "customerName": "Ade Ratu Safitri",
  "quantity": 1
}

### Quantity 0 (422)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "productId": 1,
  "customerName": "Ade Ratu Safitri",
  "quantity": 0
}

### Daftar pesanan beserta produk (200)
GET {{baseUrl}}/orders

###############################
# PRODUCTS: DELETE
###############################

### Hapus produk yang punya pesanan, ditolak (409)
DELETE {{baseUrl}}/products/1

### Hapus produk yang baru dibuat (204)
DELETE {{baseUrl}}/products/{{createProduct.response.body.data.id}}

### Hapus lagi, sudah tidak ada (404)
DELETE {{baseUrl}}/products/{{createProduct.response.body.data.id}}

### ID tidak valid (400)
DELETE {{baseUrl}}/products/abc

### Error server, MySQL dimatikan (500)
GET {{baseUrl}}/products